APP_NAME="PPAk FEB UNESA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
ASSET_URL="${APP_URL}"

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database configuration (MySQL / MariaDB XAMPP)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ppak_feb_unesa
DB_USERNAME=root
DB_PASSWORD=

# Session centralized for horizontal scaling (database/redis, not file)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Filesystem abstraction - local dev, s3 for production/CDN
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

# Cache abstraction - database dev, redis production (no code change)
CACHE_STORE=database
CACHE_PREFIX=ppak

# PPAk institution config
PPAK_NAME="Pendidikan Profesi Akuntansi"
PPAK_FACULTY="Fakultas Ekonomika dan Bisnis"
PPAK_UNIVERSITY="Universitas Negeri Surabaya"
PPAK_SHORT="PPAk FEB UNESA"
PPAK_EMAIL="ppak.feb@unesa.ac.id"
PPAK_PHONE="+62 31 828 0009"

# Pagination
PPAK_PER_PAGE_BERITA=6
PPAK_PER_PAGE_BERITA_HOME=3

# Search driver (database -> meilisearch without Blade change)
SEARCH_DRIVER=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# CDN readiness - set to CDN url in production
CDN_URL="${ASSET_URL}"

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
